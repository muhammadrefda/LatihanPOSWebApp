@model IEnumerable<PointOfSalesWebApp.Models.Category>

<h1>Daftar Kategori</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tambah Kategori Baru</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nama Kategori</th>
            <th>Deskripsi</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.CategoryName</td>
                <td>@category.Description</td>
                <td>@(category.Active ? "Aktif" : "Tidak Aktif")</td>
                <td>
                    <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-primary">Delete</a>
                </td>
            </tr>
        }
    </tbody>
    
