@model PointOfSalesWebApp.Models.Product

<h1>Hapus Produk</h1>
<h3>Apakah Anda yakin ingin menghapus produk ini?</h3>

<div>
    <h4>@Model.ProductName</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Kategori</dt>
        <dd class="col-sm-10">@Model.Category.CategoryName</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Hapus" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Batal</a>
    </form>
</div>