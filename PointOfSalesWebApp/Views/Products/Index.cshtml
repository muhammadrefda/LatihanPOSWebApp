@model IEnumerable<PointOfSalesWebApp.Models.Product>

<h1>Daftar Produk</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Tambah Produk Baru</a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nama produk</th>
            <th>Kategori</th>
            <th>Harga</th>
            <th>Stok</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.ProductName</td>
                <td>@product.Category.CategoryName</td>
                <td>@product.Price.ToString("C", new System.Globalization.CultureInfo("id-ID"))</td>
                <td>@product.Stock</td>
                <td>
                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Edit</a>
                    <a asp-controller="Products" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Delete</a>
                </td>
        </tr>
        }
    </tbody>
</table>